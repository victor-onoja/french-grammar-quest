# Copy this file to .env.local and fill in the two values from your Supabase
# project (Dashboard -> Project Settings -> API). .env.local is gitignored.
#
# Leave these unset and the game runs exactly as before, on localStorage only:
# the cloud button simply does not appear.
#
# The anon key is PUBLIC by design -- it ships inside the browser bundle, and
# row-level security is what actually protects the data. It is kept here to
# stay out of source control and so it can be rotated, not because it is secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
